# =============================================================================
# Gate self-host — environment for docker/docker-compose.yml
#
#   cp docker/.env.example docker/.env      # then fill in the blanks
#
# Compose auto-loads docker/.env (the compose file's directory) for both
# build-arg interpolation and the web container's runtime env.
#
# Build-time vs runtime (important):
#   - NEXT_PUBLIC_* are BAKED INTO the browser bundle by `next build`. Changing
#     any of them requires a rebuild:
#         docker compose -f docker/docker-compose.yml build web
#   - SUPABASE_SERVICE_ROLE_KEY and ANTHROPIC_API_KEY are read at RUNTIME and
#     can be changed with just a container restart.
# =============================================================================

# --- Supabase connection (the web app talks to Supabase, not raw Postgres) ----
# Point this at your Supabase instance's API gateway:
#   - Official self-host stack  -> the Kong gateway, e.g. http://localhost:8000
#       https://supabase.com/docs/guides/self-hosting/docker
#   - `supabase start` local     -> http://localhost:54321  (see `supabase status`)
#   - Hosted project             -> https://<project-ref>.supabase.co
# NOTE: baked into the browser bundle at build time (see header).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# Public anon key from your Supabase instance (`supabase status` / project API
# settings). Baked into the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the public profile page and account deletion. Read at
# runtime. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (paste-import structuring during onboarding) -------------------
# Optional: onboarding offers "skip, start empty" when this is unset. Read at
# runtime.
ANTHROPIC_API_KEY=

# --- Web app ------------------------------------------------------------------
# Where the web app itself is served (used for auth redirects). Baked into the
# browser bundle at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Telegram approval bot (Phase 3) ------------------------------------------
# Bot username WITHOUT the leading @ (e.g. my_gate_bot), used to deep-link
# approval notifications. Optional — leave blank until the Telegram flow is
# wired up. Baked into the browser bundle at build time.
NEXT_PUBLIC_TELEGRAM_BOT=
