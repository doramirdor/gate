# Per-Dockerfile ignore (BuildKit honors "<dockerfile>.dockerignore" next to the
# Dockerfile). The build context is the repo ROOT, so trim everything the build
# regenerates or never needs. If a builder ignores this file the build is still
# correct — `npm ci` and `next build` recreate node_modules/.next regardless.

# Installed by `npm ci` inside the image — never ship host (darwin) modules.
node_modules
**/node_modules

# Build output — regenerated by `next build`.
.next
**/.next
out
dist
*.tsbuildinfo

# VCS / local junk.
.git
.gitignore
.DS_Store

# Local secrets — never bake into an image layer (compose injects env at run/build).
.env
.env.*
**/.env
**/.env.*

# The docker assets themselves don't belong in the app build context.
docker

# Editor / CI noise.
.vscode
.idea
.vercel
