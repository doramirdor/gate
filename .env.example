# --- Supabase (hosted project or `supabase start` local stack) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the public profile page and account deletion. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (paste-import structuring during onboarding) ---
ANTHROPIC_API_KEY=

# --- Web app ---
# Where the web app itself is served (used for auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Telegram (approval pushes) ---
# Bot @username WITHOUT the leading @ — the settings page builds the connect
# deep link (https://t.me/<bot>?start=<code>) from this.
NEXT_PUBLIC_TELEGRAM_BOT=
# Note: TELEGRAM_BOT_TOKEN and TELEGRAM_WEBHOOK_SECRET are server-only and live
# in the edge-function environment, not here.
